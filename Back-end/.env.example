# Kết nối MySQL: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# (Mật khẩu có ký tự đặc biệt như @ # : / cần mã hóa URL, VD: @ -> %40)
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/gicungco"

# Khóa ký JWT — đổi thành chuỗi ngẫu nhiên dài
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

PORT=3000
# Thư mục lưu ảnh sản phẩm tải lên (mặc định: Back-end/uploads). Khi deploy cần là ổ đĩa lưu lâu dài
UPLOAD_DIR="uploads"
# Địa chỉ Front-end được phép gọi API (phân tách bằng dấu phẩy)
CORS_ORIGIN="http://localhost:5173"

# Chỉ dùng khi demo trên máy cá nhân: "true" = hiện mã OTP ngay trên trang. Không bật khi deploy
OTP_DEMO_MODE="false"

# Gửi mã quên mật khẩu (bỏ trống: mã chỉ ghi ra log server; production chỉ ghi log lỗi, người dùng vẫn nhận thông báo chung)
# Email qua SMTP — VD Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT=587, SMTP_PASS là "Mật khẩu ứng dụng"
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="GICUNGCO <no-reply@gicungco.vn>"
# SMS qua Twilio (https://www.twilio.com) — TWILIO_FROM là số điện thoại Twilio cấp
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
